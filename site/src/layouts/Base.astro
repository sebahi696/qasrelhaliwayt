---
import { t, otherLang, type Lang } from '../i18n';
import menu from '../data/menu.json';
interface Props { lang: Lang; title: string; description: string; path: string; image?: string; jsonld?: any[]; noindex?: boolean; shop?: boolean }
const { lang, title, description, path, image, jsonld = [], noindex = false, shop = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.toString() || 'https://qasralhalaweyat.com').replace(/\/$/, '');
const url = (l: Lang, p = path) => `${base}/${l}/${p}`.replace(/\/+/g, '/').replace(/\/?$/, '/');
const abs = (p: string) => `${site}${p}`;
const ol = otherLang(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const fullTitle = title === t(lang, 'brand') ? `${title} · ${t(lang, 'tagline')}` : `${title} · ${t(lang, 'brand')}`;
const ogImage = abs(image || `${base}/img/menu/gallery3.webp`);
const wa = '9613215616';
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Qasr Al Halaweyat', alternateName: 'قصر الحلويات العربية', url: site, logo: abs(`${base}/img/menu/logo.png`), sameAs: ['https://www.instagram.com/qasralhalaweyat/', 'https://www.facebook.com/QasrAlHalaweyat/', 'https://www.tiktok.com/@qasralhalaweyat'], contactPoint: [{ '@type': 'ContactPoint', telephone: '+961-1-745752', contactType: 'customer service', areaServed: 'LB', availableLanguage: ['ar', 'en'] }] };
const nav = [['menu', 'nav_menu'], ['shop', 'nav_shop'], ['branches', 'nav_branches'], ['about', 'nav_about'], ['contact', 'nav_contact']] as const;
---
<!doctype html>
<html lang={lang} dir={dir}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{fullTitle}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<link rel="canonical" href={abs(url(lang))}>
<link rel="alternate" hreflang="en" href={abs(url('en'))}>
<link rel="alternate" hreflang="ar" href={abs(url('ar'))}>
<link rel="alternate" hreflang="x-default" href={abs(url('en'))}>
<meta property="og:type" content="website"><meta property="og:site_name" content="Qasr Al Halaweyat">
<meta property="og:title" content={fullTitle}><meta property="og:description" content={description}><meta property="og:image" content={ogImage}><meta property="og:url" content={abs(url(lang))}><meta property="og:locale" content={lang === 'ar' ? 'ar_LB' : 'en_US'}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#FBF7F0">
<link rel="icon" href={`${base}/img/menu/icon-192.png`}><link rel="apple-touch-icon" href={`${base}/img/menu/icon-192.png`}>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marcellus&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap">
<script type="application/ld+json" set:html={JSON.stringify(org)} />
{jsonld.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<script is:inline define:vars={{ lang, base }}>window.QS = { lang, base };</script>
<script is:inline defer src={`${base}/app/config.js`}></script>
<script is:inline defer src={`${base}/cart.js`}></script>
<style is:global>
:root{--gold:#B8822E;--gold-deep:#8F6118;--gold-soft:#F3E6CF;--indigo:#1F2A6B;--indigo-deep:#141B49;--indigo-soft:#E6E9F6;--turq:#2E9FD1;--ivory:#FBF7F0;--paper:#fff;--sand:#EADFCB;--line:#E7DCC7;--ink:#1C1812;--muted:#6B6257;--ok:#2E7D4F;--ok-bg:#E4F2EA;--danger:#B3261E;--display:'Marcellus',Georgia,serif;--body:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',sans-serif;--ar:'Tajawal','Segoe UI',Tahoma,sans-serif;--w:1120px;color-scheme:light}
*{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;background:var(--ivory);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased}
[dir=rtl] body{font-family:var(--ar)} [dir=rtl] .disp{font-family:var(--ar);font-weight:800;letter-spacing:0}
a{color:inherit} img{max-width:100%;display:block} button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer} input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--turq);outline-offset:2px}
.disp{font-family:var(--display);font-weight:400;letter-spacing:.01em;text-wrap:balance;line-height:1.1}
.wrap{max-width:var(--w);margin:0 auto;padding-left:max(20px,env(safe-area-inset-left));padding-right:max(20px,env(safe-area-inset-right))}
.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-deep);font-weight:800} [dir=rtl] .eyebrow{letter-spacing:0}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:50px;padding:0 22px;border-radius:14px;font-weight:700;text-decoration:none;transition:transform .15s,filter .15s;white-space:nowrap}
.btn:hover{filter:brightness(1.05)} .btn:active{transform:scale(.98)} .btn.p{background:var(--indigo);color:#fff} .btn.g{background:linear-gradient(135deg,#C6903A,var(--gold-deep));color:#fff} .btn.o{background:var(--paper);border:1.5px solid var(--line)} .btn.wa{background:#25D366;color:#fff} .btn.sm{height:40px;padding:0 14px;font-size:14px;border-radius:11px}
.chip{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:700;background:var(--gold-soft);color:var(--gold-deep)} .chip.ok{background:var(--ok-bg);color:var(--ok)} .chip.ind{background:var(--indigo-soft);color:var(--indigo)}
.card{background:var(--paper);border:1px solid var(--line);border-radius:22px}
.muted{color:var(--muted)} .money{font-variant-numeric:tabular-nums}
header.top{position:sticky;top:0;z-index:20;background:rgba(251,247,240,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
header.top .wrap{display:flex;align-items:center;gap:18px;height:68px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none} .logo img{width:34px;height:40px;object-fit:contain} .logo b{font-family:var(--display);font-weight:400;font-size:17px;line-height:1.05;display:block} .logo small{display:block;font-size:11px;color:var(--gold-deep);font-weight:700}
[dir=rtl] .logo b{font-family:var(--ar);font-weight:800}
nav.main{display:flex;gap:4px;margin-inline-start:auto} nav.main a{text-decoration:none;font-weight:700;font-size:14px;padding:8px 12px;border-radius:10px} nav.main a:hover,nav.main a[aria-current]{background:var(--gold-soft);color:var(--gold-deep)}
.hdr-actions{display:flex;gap:8px;align-items:center}
.langsw{font-weight:800;font-size:13px;width:40px;height:40px;border-radius:12px;border:1.5px solid var(--line);display:grid;place-items:center;text-decoration:none;background:var(--paper)}
.cartbtn{position:relative;width:40px;height:40px;border-radius:12px;border:1.5px solid var(--line);display:grid;place-items:center;background:var(--paper)} .cartbtn i{position:absolute;top:-6px;inset-inline-end:-6px;min-width:18px;height:18px;border-radius:9px;background:var(--gold);color:#fff;font-size:11px;font-weight:800;display:grid;place-items:center;padding:0 5px;font-style:normal}
.burger{display:none;width:40px;height:40px;border-radius:12px;border:1.5px solid var(--line);background:var(--paper);place-items:center}
@media (max-width:860px){nav.main{display:none;position:absolute;top:68px;left:0;right:0;background:var(--ivory);border-bottom:1px solid var(--line);flex-direction:column;padding:10px 16px 16px} nav.main.open{display:flex} .burger{display:grid}}
footer{background:var(--indigo-deep);color:#C9C4DA;margin-top:70px;padding:50px 0 30px} footer .wrap{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px} footer h4{color:#fff;margin:0 0 10px;font-size:14px;letter-spacing:.08em;text-transform:uppercase} footer a{color:#E6E1F0;text-decoration:none;display:block;padding:3px 0;font-size:14px} footer a:hover{color:var(--gold)} footer .fine{grid-column:1/-1;border-top:1px solid rgba(255,255,255,.1);padding-top:18px;font-size:12px;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between}
@media (max-width:860px){footer .wrap{grid-template-columns:1fr 1fr}}
.grid{display:grid;gap:16px} .grid.c3{grid-template-columns:repeat(3,1fr)} .grid.c4{grid-template-columns:repeat(4,1fr)} .grid.c2{grid-template-columns:repeat(2,1fr)}
@media (max-width:860px){.grid.c3,.grid.c4{grid-template-columns:repeat(2,1fr)}} @media (max-width:520px){.grid.c4,.grid.c3,.grid.c2{grid-template-columns:1fr}}
.sec{padding:56px 0 0} .sec-h{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:22px;flex-wrap:wrap} .sec-h h2{font-size:34px;margin:4px 0 0} .sec-h p{margin:4px 0 0;color:var(--muted)}
.pcard{display:flex;flex-direction:column;overflow:hidden;text-decoration:none;transition:transform .2s,box-shadow .2s} .pcard:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(31,42,107,.1)} .pcard .ph{aspect-ratio:1;background:var(--gold-soft);overflow:hidden} .pcard img{width:100%;height:100%;object-fit:cover;transition:transform .6s} .pcard:hover img{transform:scale(1.04)} .pcard .ph .e{display:grid;place-items:center;height:100%;font-size:44px}
.pcard .b{padding:14px 16px 16px;display:flex;flex-direction:column;gap:4px} .pcard .n{font-weight:800} .pcard .d{font-size:13px;color:var(--muted)} .pcard .pr{font-weight:800;color:var(--indigo);margin-top:4px} .pcard .pr small{font-weight:600;color:var(--muted)}
.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.drawer-bg{position:fixed;inset:0;background:rgba(20,24,40,.45);z-index:40;opacity:0;pointer-events:none;transition:opacity .25s} .drawer-bg.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;bottom:0;inset-inline-end:0;width:min(420px,100%);background:var(--ivory);z-index:41;transform:translateX(100%);transition:transform .35s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column} [dir=rtl] .drawer{transform:translateX(-100%)} .drawer.on{transform:none}
.drawer .dh{display:flex;align-items:center;gap:10px;padding:18px 20px;border-bottom:1px solid var(--line)} .drawer .dh h3{margin:0;font-size:22px;flex:1} .drawer .dl{flex:1;overflow:auto;padding:10px 20px}
.drawer .df{padding:16px 20px calc(16px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--paper)}
.cl{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);align-items:center} .cl img{width:58px;height:58px;border-radius:12px;object-fit:cover} .cl .n{font-weight:800;font-size:14px} .cl .s{font-size:12px;color:var(--muted)} .cl .q{display:inline-flex;align-items:center;border:1.5px solid var(--line);border-radius:10px;height:34px;background:var(--paper)} .cl .q button{width:32px;height:100%;font-weight:700} .cl .q span{min-width:22px;text-align:center;font-weight:800;font-size:14px}
.sum{display:flex;justify-content:space-between;padding:4px 0;font-size:14px} .sum.tot{font-weight:800;font-size:17px;border-top:1px dashed var(--line);margin-top:6px;padding-top:10px}
.minbar{margin:0 0 10px;padding:10px 12px;border-radius:12px;background:var(--indigo-soft);color:var(--indigo);font-size:12.5px;font-weight:600} .minbar.warn{background:var(--gold-soft);color:var(--gold-deep)} .minbar .tr{height:6px;border-radius:3px;background:rgba(255,255,255,.7);margin-top:8px;overflow:hidden} .minbar .tr i{display:block;height:100%;background:var(--indigo);border-radius:3px}
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);background:var(--ink);color:var(--ivory);padding:12px 18px;border-radius:14px;font-weight:700;z-index:60;opacity:0;transition:all .3s;pointer-events:none} .toast.show{opacity:1;transform:translate(-50%,0)}
.field{display:flex;flex-direction:column;gap:6px} .field label{font-size:12px;font-weight:700;color:var(--muted)} .field input,.field select,.field textarea{height:50px;border-radius:14px;border:1.5px solid var(--line);background:var(--paper);padding:0 14px;width:100%} .field textarea{height:auto;padding:12px 14px} .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--indigo);outline:none}
.prose{max-width:68ch;font-size:17px;line-height:1.7} .prose h2{font-size:28px;margin:34px 0 10px} .prose p{margin:0 0 16px}
.hero{position:relative;overflow:hidden;border-radius:0 0 48px 48px;background:var(--indigo-deep);color:#fff} .hero .bg{position:absolute;inset:0;background-position:center;background-size:cover;opacity:.55} .hero::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,rgba(20,27,73,.92) 0%,rgba(20,27,73,.6) 50%,rgba(20,27,73,.15) 100%)} [dir=rtl] .hero::after{background:linear-gradient(260deg,rgba(20,27,73,.92) 0%,rgba(20,27,73,.6) 50%,rgba(20,27,73,.15) 100%)}
.hero .wrap{position:relative;z-index:1;padding-top:70px;padding-bottom:70px;max-width:var(--w)} .hero h1{font-size:clamp(34px,5.2vw,60px);margin:10px 0 14px;max-width:16ch} .hero p{font-size:18px;max-width:52ch;opacity:.92;margin:0 0 26px} .hero .eyebrow{color:var(--gold)}
.hero .arch{position:absolute;inset-inline-end:6%;top:50%;transform:translateY(-50%);width:min(260px,28vw);opacity:.18;z-index:1;pointer-events:none}
@media (max-width:860px){.hero{border-radius:0 0 32px 32px} .hero .wrap{padding-top:48px;padding-bottom:48px}}
.bcard{padding:20px;display:flex;flex-direction:column;gap:8px} .bcard h3{margin:0;font-size:22px} .bcard .kv{font-size:14px;color:var(--muted)} .bcard .acts{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}
.catchip{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;background:var(--paper);border:1px solid var(--line);font-weight:700;font-size:14px;text-decoration:none;white-space:nowrap} .catchip:hover,.catchip[aria-current]{background:var(--indigo);color:#fff;border-color:var(--indigo)}
.cats{display:flex;gap:8px;overflow-x:auto;padding:4px 0 10px;scrollbar-width:none}
.item{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--line);align-items:center;text-decoration:none} .item img,.item .e{width:84px;height:84px;border-radius:16px;object-fit:cover;flex:none;background:var(--gold-soft);display:grid;place-items:center;font-size:28px} .item .n{font-weight:800} .item .d{font-size:13px;color:var(--muted)} .item .pr{font-weight:800;color:var(--indigo);margin-inline-start:auto;white-space:nowrap} .item .pr small{font-weight:600;color:var(--muted)}
.tile{position:relative;border-radius:22px;overflow:hidden;aspect-ratio:4/3;color:#fff;text-decoration:none;display:block;background:var(--indigo)} .tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .7s} .tile:hover img{transform:scale(1.05)} .tile::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(20,27,73,.85),rgba(20,27,73,.05) 60%)} .tile .tx{position:absolute;inset:auto 18px 18px;z-index:1} .tile .tx b{font-family:var(--display);font-weight:400;font-size:24px;display:block} [dir=rtl] .tile .tx b{font-family:var(--ar);font-weight:800} .tile .tx span{font-size:13px;opacity:.9}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body data-lang={lang} data-base={base} data-wa={wa}>
<header class="top"><div class="wrap">
  <a class="logo" href={url(lang, '')}><img src={`${base}/img/menu/mark.png`} alt="" width="34" height="40"><span><b>{t(lang,'brand')}</b><small>{t(lang,'brandAr')}</small></span></a>
  <nav class="main" id="mainNav">{nav.map(([p,k]) => <a href={url(lang,p)} aria-current={path.split('/')[0]===p?'page':undefined}>{t(lang,k as any)}</a>)}<a href={`${base}/app/`} class="btn p sm" style="margin-inline-start:8px">{t(lang,'nav_app')}</a></nav>
  <div class="hdr-actions">
    <a class="langsw" href={url(ol)} hreflang={ol} lang={ol}>{ol === 'ar' ? 'ع' : 'EN'}</a>
    <button class="cartbtn" id="cartBtn" aria-label={t(lang,'cart')}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l1 13H5z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg><i id="cartN" hidden>0</i></button>
    <button class="burger" id="burger" aria-label="Menu">☰</button>
  </div>
</div></header>

<slot />

<footer><div class="wrap">
  <div><a class="logo" href={url(lang,'')} style="margin-bottom:12px"><img src={`${base}/img/menu/mark_white.png`} alt="" width="34" height="40"><span><b style="color:#fff">{t(lang,'brand')}</b><small>{t(lang,'brandAr')}</small></span></a><p style="font-size:14px;max-width:34ch;margin:0">{t(lang,'tagline')}. Malla · Corniche El Mazraa · Aramoun.</p></div>
  <div><h4>{t(lang,'nav_menu')}</h4>{menu.categories.map(c => <a href={url(lang,`menu/${c.id}`)}>{(c.name as any)[lang]}</a>)}</div>
  <div><h4>{t(lang,'nav_shop')}</h4><a href={url(lang,'shop')}>{t(lang,'shop_title')}</a><a href={url(lang,'shipping')}>{t(lang,'shipping_title')}</a><a href={url(lang,'branches')}>{t(lang,'nav_branches')}</a><a href={url(lang,'about')}>{t(lang,'nav_about')}</a><a href={url(lang,'contact')}>{t(lang,'nav_contact')}</a></div>
  <div><h4>{t(lang,'follow')}</h4><a href="https://www.instagram.com/qasralhalaweyat/" target="_blank" rel="noopener">Instagram</a><a href="https://www.facebook.com/QasrAlHalaweyat/" target="_blank" rel="noopener">Facebook</a><a href="https://www.tiktok.com/@qasralhalaweyat" target="_blank" rel="noopener">TikTok</a><a href={`https://wa.me/${wa}`} target="_blank" rel="noopener">WhatsApp</a><a href={`${base}/app/`}>{t(lang,'nav_app')}</a></div>
  <div class="fine"><span>© {new Date().getFullYear()} Qasr Al Halaweyat · {t(lang,'rights')}</span><span><a href={url(lang,'privacy')} style="display:inline">{t(lang,'privacy')}</a> · <a href={`${base}/staff/`} style="display:inline">Staff</a></span></div>
</div></footer>

<div class="drawer-bg" id="drawerBg"></div>
<aside class="drawer" id="drawer" aria-label={t(lang,'cart')}>
  <div class="dh"><h3 class="disp">{t(lang,'cart')}</h3><button id="drawerX" class="cartbtn" aria-label="Close">✕</button></div>
  <div class="dl" id="cartList"></div>
  <div class="df" id="cartFoot"></div>
</aside>
<div class="toast" id="toast"></div>

<script is:inline>
document.getElementById('burger').onclick=()=>document.getElementById('mainNav').classList.toggle('open');
</script>
</body>
</html>
