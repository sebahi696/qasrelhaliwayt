---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="refresh" content={`0;url=${base}/en/`}><link rel="canonical" href={`${base}/en/`}><title>Qasr Al Halaweyat</title><script is:inline define:vars={{base}}>const l=(navigator.language||'').toLowerCase().startsWith('ar')?'ar':'en';location.replace(`${base}/${l}/`);</script></head><body><a href={`${base}/en/`}>English</a> · <a href={`${base}/ar/`}>العربية</a></body></html>
