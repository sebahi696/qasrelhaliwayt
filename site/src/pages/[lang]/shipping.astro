---
import Base from '../../layouts/Base.astro';
import { langs, t, L, money, type Lang } from '../../i18n';
import menu from '../../data/menu.json';
export function getStaticPaths() { return langs.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang; const base = import.meta.env.BASE_URL.replace(/\/$/, ''); const I = menu.intl;
const en = ['We ship dry sweets only: maamoul, baklawa and gift boxes. Fresh items such as knefeh, ashta desserts and platters are available in Lebanon only.', 'Every order is vacuum-sealed in tins the day it ships and handed to DHL Express within 24 hours of confirmation.', `Minimum international order is ${money(I.minOrderUsd)}. Shipping is free on orders over ${money(I.freeOver)}.`, 'Shipping is calculated by weight at checkout. Customs duties or import taxes, where applicable, are paid by the recipient.', 'You receive a DHL tracking number by email and WhatsApp. Delivery takes 2–7 business days depending on the destination.', 'Because our sweets are perishable, orders cannot be returned once shipped. If a parcel arrives damaged, send us photos within 24 hours and we will replace it or refund you.'];
const ar = ['نشحن الحلويات الجافة فقط: معمول، بقلاوة وعلب هدايا. الأصناف الطازجة كالكنافة وحلويات القشطة والصحون متوفرة في لبنان فقط.', 'يُغلَّف كل طلب بإحكام في علب يوم الشحن ويُسلَّم إلى DHL Express خلال ٢٤ ساعة من التأكيد.', `الحد الأدنى للطلب الدولي ${money(I.minOrderUsd)}. الشحن مجاني للطلبات فوق ${money(I.freeOver)}.`, 'يُحسب الشحن حسب الوزن عند إتمام الطلب. الرسوم الجمركية أو ضرائب الاستيراد، إن وُجدت، يدفعها المستلم.', 'تصلك رقم تتبع DHL عبر البريد وواتساب. يستغرق التوصيل ٢–٧ أيام عمل حسب الوجهة.', 'لأن حلوياتنا قابلة للتلف، لا يمكن إرجاع الطلبات بعد الشحن. إذا وصل الطرد متضرراً، أرسل لنا الصور خلال ٢٤ ساعة ونستبدله أو نعيد المبلغ.'];
const ps = lang === 'ar' ? ar : en;
---
<Base lang={lang} title={t(lang,'shipping_title')} description={ps[0] + ' ' + ps[2]} path="shipping">
<div class="wrap" style="padding-top:36px"><div class="eyebrow">DHL Express</div><h1 class="disp" style="font-size:44px;margin:6px 0 18px">{t(lang,'shipping_title')}</h1>
<div class="prose">{ps.map(p => <p>{p}</p>)}</div>
<h2 class="disp" style="font-size:28px;margin:30px 0 12px">{t(lang,'ship_to')}</h2>
<div class="card" style="overflow:auto"><table style="width:100%;border-collapse:collapse;font-size:14px"><thead><tr style="text-align:start"><th style="padding:12px 14px;text-align:start">{t(lang,'country')}</th><th style="padding:12px 14px;text-align:start">{t(lang,'first_kg')}</th><th style="padding:12px 14px;text-align:start">{t(lang,'each_kg')}</th><th style="padding:12px 14px;text-align:start">{t(lang,'days')}</th></tr></thead><tbody>{I.countries.filter((c: any) => c.enabled).map((c: any) => <tr style="border-top:1px solid var(--line)"><td style="padding:10px 14px">{c.flag} {L(c.name,lang)}</td><td style="padding:10px 14px" class="money">{money(c.base)}</td><td style="padding:10px 14px" class="money">{money(c.ratePerKg)}</td><td style="padding:10px 14px">{c.days}</td></tr>)}</tbody></table></div>
<div class="row" style="margin-top:22px"><a class="btn g" href={`${base}/${lang}/shop/`}>{t(lang,'cta_shop')}</a></div></div>
</Base>
